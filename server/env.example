# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Server
PORT=3001
# Leave blank to disable proxy trust.
# Set explicitly (true/false/number/CIDR list) for your proxy topology.
TRUST_PROXY=
CORS_ORIGIN=https://mydomain.com
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SUBMIT_RATE_WINDOW_MS=60000
SUBMIT_RATE_MAX=30
# public | hybrid | signed (public accepts unsigned submissions)
INGEST_MODE=public
# Required when INGEST_MODE=signed
INGEST_HMAC_SECRET=
POW_ENABLED=0
POW_DIFFICULTY=0
SUBMIT_TOKEN_TTL_SECONDS=60
# Required in production. Uploaded encoded artifacts are retained under this
# root and analyzed server-side; use a durable mounted volume/object-store path.
ARTIFACT_STORAGE_ROOT=/app/artifacts
ARTIFACT_UPLOAD_SECRET=
ARTIFACT_AUTO_ANALYZE=1
ARTIFACT_MAX_BYTES=2147483648
# Frozen PL v7 workload reference bitrates. Keys must match the emitted workload ID.
# Leave empty until calibration data has been reviewed; missing contexts yield no canonical PL Score.
PL_V7_REFERENCE_CONTEXT_VERSION=calibration-v1
PL_V7_REFERENCE_BITRATES_JSON={"sports-1080p":4000000}

# Frontend
INTERNAL_API_BASE_URL=https://api.mydomain.com
APP_URL=https://app.mydomain.com
NEXT_PUBLIC_APP_URL=https://app.mydomain.com
ENABLE_QUERY_MOCK=0
