# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Server
PORT=3001
# Leave blank to disable proxy trust.
# Set explicitly (true/false/number/CIDR list) for your proxy topology.
TRUST_PROXY=
CORS_ORIGIN=https://mydomain.com
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SUBMIT_RATE_WINDOW_MS=60000
SUBMIT_RATE_MAX=30
# public | hybrid | signed (public accepts unsigned submissions)
INGEST_MODE=public
# Required when INGEST_MODE=signed
INGEST_HMAC_SECRET=
POW_ENABLED=0
POW_DIFFICULTY=0
SUBMIT_TOKEN_TTL_SECONDS=60

# Frontend (public)
NEXT_PUBLIC_API_BASE_URL=https://mydomain.com
