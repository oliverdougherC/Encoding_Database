# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Server
PORT=3001
# Production compose has one nginx proxy hop. Change only with topology review.
TRUST_PROXY=1
CORS_ORIGIN=https://mydomain.com
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SUBMIT_RATE_WINDOW_MS=60000
SUBMIT_RATE_MAX=30
# public | hybrid | signed (public accepts unsigned submissions)
INGEST_MODE=public
# Required when INGEST_MODE=signed
INGEST_HMAC_SECRET=
ALLOW_TEST_ONLY_REFERENCE_CONTEXTS=0
POW_ENABLED=0
POW_DIFFICULTY=0
SUBMIT_TOKEN_TTL_SECONDS=60
ARTIFACT_UPLOAD_SECRET=
ARTIFACT_STORAGE_ROOT=/app/artifacts
ARTIFACT_VOLUME_NAME=encodingdb_prod_artifact_data
ARTIFACT_AUTO_ANALYZE=1
ARTIFACT_VALIDATE_MEDIA_BEFORE_PUBLISH=1
ARTIFACT_MAX_BYTES=2147483648
ARTIFACT_UPLOAD_TTL_MS=900000
ARTIFACT_AUTH_RATE_WINDOW_MS=60000
ARTIFACT_AUTH_RATE_MAX=30
ARTIFACT_UPLOAD_RATE_WINDOW_MS=60000
ARTIFACT_UPLOAD_RATE_MAX=20
ARTIFACT_UPLOAD_CONCURRENCY_MAX=4
ARTIFACT_PENDING_UPLOAD_MAX=500
ARTIFACT_PENDING_ANALYSIS_MAX=500
ARTIFACT_STORAGE_QUOTA_BYTES=0
ARTIFACT_STORAGE_RESERVE_BYTES=536870912
ARTIFACT_ANALYSIS_CONCURRENCY_MAX=2
ARTIFACT_ANALYSIS_POLL_MS=1000
ARTIFACT_ANALYSIS_LEASE_MS=300000
ARTIFACT_ANALYSIS_RETRY_BACKOFF_MS=5000
ARTIFACT_ANALYSIS_MAX_ATTEMPTS=3
V7_PENDING_UPLOAD_ALERT_SECONDS=900
V7_PENDING_ANALYSIS_ALERT_SECONDS=1800
V7_ORPHAN_STAGING_ALERT_SECONDS=3600
PL_V7_REFERENCE_CONTEXT_PATH=
PL_V7_REFERENCE_CONTEXT_VERSION=
PL_V7_REFERENCE_BITRATES_JSON=

# Frontend
INTERNAL_API_BASE_URL=http://server:3001
APP_URL=https://app.mydomain.com
NEXT_PUBLIC_APP_URL=https://app.mydomain.com
ENABLE_QUERY_MOCK=0
